    {
      "SurveyID": "SV_3kLZ1KUE87N0MMm",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "welcome",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "\n<p style='font-size:1.15em;font-weight:600;margin-bottom:.4em'>Before you start</p>\n\n<p>This is a class activity for LX 433/733. You will see a series of pictures of\nboxes, and on each screen you will be asked to choose one of them. It takes\nabout five minutes.</p>\n\n<p><b>Taking part is voluntary.</b> You may stop at any time by closing the\nwindow, and you do not have to answer any question you would rather skip.\nNothing about your grade depends on <i>which</i> boxes you choose. At the end\nyou will be asked whether your responses may be included in the class analysis,\nand saying no there will not affect your credit for the activity.</p>\n\n<p><b>Risks and benefits.</b> There are no risks beyond those of ordinary\ncomputer use. The class will analyse its own data together, which is the point\nof the exercise.</p>\n\n<p><b>What happens to your responses.</b> They are recorded alongside your\nKerberos ID so that completion can be credited. The analysis reports the class\nas a whole; no individual's answers are identified in class or in anyone's\nwrite-up, and the data are not published.</p>\n\n<p><b>Questions</b> at any point, now or later: Elizabeth Coppock,\n<a href='mailto:ecoppock@bu.edu'>ecoppock@bu.edu</a>.</p>\n\n<p style='margin-top:1em'>Clicking the arrow below means you have read this and\nagree to take part.</p>\n",
        "DefaultChoices": false,
        "DataExportTag": "welcome",
        "QuestionID": "QID1",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "welcome",
        "Validation": {
          "Settings": {
            "ForceResponse": "OFF",
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1
      }
    },
    {
      "SurveyID": "SV_3kLZ1KUE87N0MMm",
      "Element": "SQ",
      "PrimaryAttribute": "QID2",
      "SecondaryAttribute": "Give me the box where Ral has a carrot.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p>On each screen you will see three boxes. Two are open, so you can see what is inside. The third is closed, so you cannot.</p><p>Each time, choose the box that matches the description. <b>If neither open box matches, the box you want must be the closed one.</b></p><p>These first few screens are practice.</p><br><span style=\"font-size:19px;\">Give me the box where Ral has a carrot.</span>",
        "DataExportTag": "fam1",
        "QuestionType": "MC",
        "Selector": "SAHR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText",
          "LabelPosition": "BELOW"
        },
        "QuestionDescription": "Give me the box where Ral has a carrot.",
        "Choices": {
          "1": {
            "Display": "<img src=\"https://raw.githubusercontent.com/eecoppock/covered-box-replication/main/stimuli/p10_mushroom__carrot.png\" style=\"width:100%;max-width:280px;height:auto;\" alt=\"\">"
          },
          "2": {
            "Display": "<img src=\"https://raw.githubusercontent.com/eecoppock/covered-box-replication/main/stimuli/p10_carrot__mushroom.png\" style=\"width:100%;max-width:280px;height:auto;\" alt=\"\">"
          },
          "3": {
            "Display": "<img src=\"https://raw.githubusercontent.com/eecoppock/covered-box-replication/main/stimuli/covered.png\" style=\"width:100%;max-width:280px;height:auto;\" alt=\"\">"
          }
        },
        "ChoiceOrder": [
          "3",
          "1",
          "2"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "Type": "None"
          }
        },
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID2"
      }
    },
