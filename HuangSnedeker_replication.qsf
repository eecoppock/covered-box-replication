    {
      "SurveyID": "SV_3kLZ1KUE87N0MMm",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Give me the box where Ral has a carrot.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p>On each screen you will see three boxes. Two are open, so you can see what is inside. The third is closed, so you cannot.</p><p>Each time, choose the box that matches the description. <b>If neither open box matches, the box you want must be the closed one.</b></p><p>These first few screens are practice.</p><br><span style=\"font-size:19px;\">Give me the box where Ral has a carrot.</span>",
        "DataExportTag": "fam1",
        "QuestionType": "MC",
        "Selector": "SAHR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText",
          "LabelPosition": "BELOW"
        },
        "QuestionDescription": "Give me the box where Ral has a carrot.",
        "Choices": {
          "1": {
            "Display": "<img src=\"https://raw.githubusercontent.com/eecoppock/covered-box-replication/main/stimuli/p10_mushroom1_carrot1.png\" style=\"width:100%;max-width:280px;height:auto;\" alt=\"\">"
          },
          "2": {
            "Display": "<img src=\"https://raw.githubusercontent.com/eecoppock/covered-box-replication/main/stimuli/p10_carrot1_mushroom1.png\" style=\"width:100%;max-width:280px;height:auto;\" alt=\"\">"
          },
          "3": {
            "Display": "<img src=\"https://raw.githubusercontent.com/eecoppock/covered-box-replication/main/stimuli/covered.png\" style=\"width:100%;max-width:280px;height:auto;\" alt=\"\">"
          }
        },
        "ChoiceOrder": [
          "3",
          "1",
          "2"
        ],
        "Validation": {
