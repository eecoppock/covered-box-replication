    {
      "SurveyID": "SV_HuangSnedekerRep",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Instructions",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p>In this task you will see three boxes on each screen. Two of them are open, so you can see what is inside. The third is closed, so you cannot.</p><p>Each time, you will be asked for the box that matches a description. <b>If neither open box matches, then the box you want must be the closed one.</b></p><p>There are a few practice screens first.</p>",
        "DefaultChoices": false,
        "DataExportTag": "Instructions",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Instructions",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID1"
      }
    },
